<isdecorate template="application/MenuFrame">
<div style="padding:20px">
    <h1>CyberSource Webhook Manager</h1>
    <isif condition="${pdict.success}"><div style="background:#f9f9f9;padding:10px;margin-bottom:20px;border:1px solid #ccc">Webhooks synchronized successfully.</div></isif>
    <isif condition="${pdict.error === 'no_fraud_product'}">
        <div style="background:#fce4ec;color:#c62828;padding:15px;margin-bottom:20px;border:2px solid #c62828;font-weight:bold">
            ERROR: Fraud screening was enabled but neither Decision Manager nor Fraud Management Essentials is provisioned for this merchant. The feature has been automatically disabled. Please contact Visa Acceptance support to have a fraud product provisioned.
        </div>
    </isif>
    
    <isset name="dmMismatch" value="${pdict.config.dmEnabled && !pdict.subscriptions.fraudManagement}" scope="page" />
    <isset name="ucMismatch" value="${pdict.config.secureIntegrationMethod === 'Unified_Checkout' && !pdict.subscriptions.unifiedCheckout}" scope="page" />

    <isif condition="${dmMismatch || ucMismatch}">
        <div style="background:#fce4ec;color:#c62828;padding:15px;margin-bottom:20px;border:2px solid #c62828;font-weight:bold">
            CRITICAL: Configuration Mismatch Detected! <br/>
            Some features are enabled in Site Preferences but do not have active webhook subscriptions. <br/>
            Please click "Synchronize Webhooks" below to prevent order processing issues.
        </div>
    </isif>

    <div class="section-container" style="margin-bottom: 20px;">
        <p>This tool synchronizes your CyberSource webhooks with your current Site Preferences. <br/>
           Manage your features first in <b>Merchant Tools > Site Preferences > Secure Integration Configuration</b>, then click the button below.</p>
    </div>

    <form action="${pdict.actionUrl}" method="POST">
        <input type="hidden" name="action" value="sync"/>
        <table class="infobox w e s n" style="width:100%;margin-bottom:10px">
            <thead><tr><th colspan="4" class="infobox_title">Synchronization Status</th></tr></thead>
            <tr style="background:#f8f8f8">
                <td class="infobox_item"><b>Product</b></td>
                <td class="infobox_item"><b>Feature Enabled?</b></td>
                <td class="infobox_item"><b>Webhook Status</b></td>
                <td class="infobox_item"><b>Webhook ID</b></td>
            </tr>
            <tr>
                <td class="infobox_item">Fraud Management (DM & FME)</td>
                <td class="infobox_item">${pdict.config.dmEnabled ? 'YES' : 'NO'}</td>
                <td class="infobox_item">${pdict.subscriptions.fraudManagement ? 'ACTIVE' : 'NOT SUBSCRIBED'}</td>
                <td class="infobox_item">${pdict.subscriptions.fraudManagement ? pdict.subscriptions.fraudManagement.webhookId : '-'}</td>
            </tr>
            <tr>
                <td class="infobox_item">Unified Checkout (APM)</td>
                <td class="infobox_item">${pdict.config.secureIntegrationMethod === 'Unified_Checkout' ? 'YES' : 'NO'}</td>
                <td class="infobox_item">${pdict.subscriptions.unifiedCheckout ? 'ACTIVE' : 'NOT SUBSCRIBED'}</td>
                <td class="infobox_item">${pdict.subscriptions.unifiedCheckout ? pdict.subscriptions.unifiedCheckout.webhookId : '-'}</td>
            </tr>
        </table>
        <div style="text-align:right;margin-bottom:30px"><button type="submit" class="button">Synchronize Webhooks with Site Preferences</button></div>
    </form>

    <form action="${pdict.actionUrl}" method="POST">
        <input type="hidden" name="action" value="advanced"/>
        <table class="infobox w e s n" style="width:100%;margin-bottom:10px">
            <thead><tr><th colspan="2" class="infobox_title">Advanced Configuration</th></tr></thead>
            <tbody>
                <tr>
                    <td class="infobox_item" style="width:40%"><b>Custom Webhook Base URL (Optional)</b></td>
                    <td class="infobox_item">
                        <div style="margin-bottom:10px">
                            <b>Currently using:</b> <code style="background:#eee;padding:2px 5px">${pdict.config.activeBaseUrl}</code>
                            <isif condition="${!pdict.config.webhookBaseUrl}"> <span style="font-size:11px;color:#666">(Standard Storefront URL)</span></isif>
                        </div>
                        <input type="text" name="webhookBaseUrl" value="${pdict.config.webhookBaseUrl}" style="width:100%" placeholder="https://store.brand.com"/>
                        <div style="font-size:11px;color:#666;margin-top:5px">Default (if empty): <code>${pdict.config.standardBaseUrl}</code></div>
                    </td>
                </tr>
                <tr>
                    <td class="infobox_item"><b>Egress MLE Private Key Alias</b></td>
                    <td class="infobox_item">
                        <input type="text" name="egressMleAlias" value="${pdict.config.egressMleAlias}" style="width:100%" placeholder="Cybersource_MLE_Egress_Private_Key"/>
                        <div style="font-size:11px;color:#666;margin-top:5px">This must match the alias of your .p12 key in <b>Private Keys and Certificates</b>.</div>
                    </td>
                </tr>
                <tr>
                    <td class="infobox_item"><b>Egress Public Key (from certChain.pem)</b></td>
                    <td class="infobox_item">
                        <textarea name="egressPublicKey" style="width:100%; height: 100px" placeholder="-----BEGIN PUBLIC KEY-----&#10;...&#10;-----END PUBLIC KEY-----">${pdict.config.egressPublicKey}</textarea>
                        <div style="font-size:11px;color:#666;margin-top:5px">Copy the "pub" key content from the certChain.pem output file created in EBC. This is required for Asymmetric Message-Level Encryption (MLE).</div>
                    </td>
                </tr>
            </tbody>
        </table>
        <div style="text-align:right;margin-bottom:30px"><button type="submit" class="button" onclick="return confirm('Updating these settings will re-sync active webhooks. Continue?')">Update Advanced Settings</button></div>
    </form>

    <isif condition="${pdict.external && pdict.external.length > 0}">
        <div style="margin-top:10px;color:#e67e22;border:1px solid #e67e22;padding:10px;background:#fff3e0">
            <b>NOTE:</b> Found ${pdict.external.length} untracked webhooks on CyberSource. Please manage them manually in Business Center to avoid duplicate notifications.
        </div>
    </isif>
</div>
</isdecorate>
