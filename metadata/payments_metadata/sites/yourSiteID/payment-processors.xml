<?xml version="1.0" encoding="UTF-8"?>
<payment-processors xmlns="http://www.demandware.com/xml/impex/paymentprocessor/2007-03-31">
    <payment-processor processor-id="PAYMENTS_CREDIT">
        <description>Processor for Credit card handling.</description>
        <preferences>
            <all-instances/>
            <development/>
            <staging/>
            <production/>
        </preferences>
    </payment-processor>
    <payment-processor processor-id="PAYMENTS_CLICK_TO_PAY"> 
         <description>Processor for Click to Pay handling.</description>
        <preferences>
            <all-instances/>
            <development/>
            <staging/>
            <production/>
        </preferences>
    </payment-processor>
    <payment-processor processor-id="BANK_TRANSFER"> 
        <description>Processor for Bank Transfer handling.</description>
        <preferences>
            <all-instances/>
            <development/>
            <staging/>
            <production/>
        </preferences>
    </payment-processor>
    <payment-processor processor-id="PAYMENTS_APPLEPAY">
        <description>Payment processor for Apple pay</description>
        <preferences>
            <all-instances/>
            <development/>
            <staging/>
            <production/>
        </preferences>
    </payment-processor>
    <payment-processor processor-id="PAYMENTS_GOOGLEPAY">
        <description>Payment processor for Google Pay</description>
        <preferences>
            <all-instances/>
            <development/>
            <staging/>
            <production/>
        </preferences>
    </payment-processor>
    <payment-processor processor-id="ALT_PAYMENT">
        <description>Generic processor for Unified Checkout alternate payment methods (PPRO bank transfers, BNPL, PayPal, Venmo, Paze).</description>
        <preferences>
            <all-instances/>
            <development/>
            <staging/>
            <production/>
        </preferences>
    </payment-processor>
</payment-processors>