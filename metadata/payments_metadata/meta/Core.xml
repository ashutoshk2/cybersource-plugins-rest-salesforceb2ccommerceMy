<?xml version="1.0" encoding="UTF-8"?>
<metadata xmlns="http://www.demandware.com/xml/impex/metadata/2006-10-31">
    <type-extension type-id="SitePreferences">
        <custom-attribute-definitions>
            <attribute-definition attribute-id="VisaAcceptance_CartridgeEnabled">
                <display-name xml:lang="x-default">Enable VisaAcceptance Cartridge</display-name>
                <description xml:lang="x-default">Enable or disable VisaAcceptance Cartridge. If disabled none of the VisaAcceptance services are invoked.</description>
                <type>boolean</type>
                <externally-managed-flag>false</externally-managed-flag>
                <default-value>true</default-value>
            </attribute-definition>
            <attribute-definition attribute-id="VisaAcceptance_MerchantID">
                <display-name xml:lang="x-default">VisaAcceptance MerchantID</display-name>
                <description xml:lang="x-default">VisaAcceptance Merchant ID</description>
                <type>string</type>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="VisaAcceptance_MerchantKeyId">
                <display-name xml:lang="x-default">VisaAcceptance REST KeyId</display-name>
                <description xml:lang="x-default">VisaAcceptance REST Key ID</description>
                <type>string</type>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="VisaAcceptance_MerchantKeySecret">
                <display-name xml:lang="x-default">VisaAcceptance REST Secret Key</display-name>
                <description xml:lang="x-default">VisaAcceptance REST Secret Key</description>
                <type>password</type>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="VisaAcceptance_DeveloperId">
                <display-name xml:lang="x-default">DeveloperId</display-name>
                <description xml:lang="x-default">Unique identifier generated by VisaAcceptance for System Integrator</description>
                <type>string</type>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="VisaAcceptance_CommerceIndicator">
                <display-name xml:lang="x-default">Commerce Indicator</display-name>
                <type>enum-of-string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <value-definitions>
                    <value-definition default="true">
                        <display xml:lang="x-default">internet</display>
                        <value>internet</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">moto</display>
                        <value>MOTO</value>
                    </value-definition>
                </value-definitions>
            </attribute-definition>
            <attribute-definition attribute-id="VisaAcceptance_EnableTestEndpoints">
                <display-name xml:lang="x-default">Enable CyberSource Test Endpoints</display-name>
                <description xml:lang="x-default">Enable capture and auth reversal test endpoints (ServiceFrameworkTest controller). Must be explicitly enabled per sandbox instance. Disabled by default.</description>
                <type>boolean</type>
                <externally-managed-flag>false</externally-managed-flag>
                <default-value>false</default-value>
            </attribute-definition>
        </custom-attribute-definitions>
        <group-definitions>
            <attribute-group group-id="VisaAcceptance_Core">
                <display-name xml:lang="x-default">VisaAcceptance Cartridge configuration</display-name>
                <attribute attribute-id="VisaAcceptance_CartridgeEnabled"/>
                <attribute attribute-id="VisaAcceptance_MerchantID"/>
                <attribute attribute-id="VisaAcceptance_MerchantKeyId"/>
                <attribute attribute-id="VisaAcceptance_MerchantKeySecret"/>
                <attribute attribute-id="VisaAcceptance_DeveloperId"/>
                <attribute attribute-id="VisaAcceptance_CommerceIndicator"/>
                <attribute attribute-id="VisaAcceptance_EnableTestEndpoints"/>
            </attribute-group>
        </group-definitions>
    </type-extension>
</metadata>
 